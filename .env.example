# Configure these values in your local shell or IDE run configuration.
# The application does not load .env files automatically.
DB_URL=jdbc:mysql://localhost:3306/jobflow?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=replace-with-a-mysql-user
DB_PASSWORD=replace-with-a-local-password
SERVER_PORT=8080
SCHEDULER_POLL_INTERVAL=1000
SCHEDULER_BATCH_SIZE=100
WORKER_CORE_POOL_SIZE=4
WORKER_MAX_POOL_SIZE=8
WORKER_QUEUE_CAPACITY=100
WORKER_SHUTDOWN_WAIT_SECONDS=30

# Auth0 API configuration. Keep disabled for the local dev-h2 profile.
AUTH0_ENABLED=false
AUTH0_ISSUER_URI=https://your-tenant.region.auth0.com/
AUTH0_AUDIENCE=https://jobflow-api
AUTH0_CLIENT_ID=your-auth0-spa-client-id
